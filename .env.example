# Prefer PG* plus ENDPOINT_NAME for Databricks OAuth. For local or legacy
# development only, LAKEBASE_URL remains an isolated alternative.
# Never place real credentials in this tracked example file.

LAKEBASE_URL=

PGHOST=lakebase-host.example.invalid
PGDATABASE=database_name
PGUSER=application_user
PGPORT=5432
PGSSLMODE=require
ENDPOINT_NAME=projects/example-project/branches/example-branch/endpoints/example-endpoint

DB_CONNECT_TIMEOUT_SECONDS=10
DB_APPLICATION_NAME=databricks-stock-research-capstone

MASSIVE_API_KEY=
MASSIVE_API_BASE_URL=https://api.massive.com
MASSIVE_REQUEST_TIMEOUT=15
