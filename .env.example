# Prefer Databricks-injected PG* values for deployed Apps. For local or legacy
# development, set either LAKEBASE_URL or the individual PostgreSQL fields.
# Never place real credentials in this tracked example file.

LAKEBASE_URL=

PGHOST=lakebase-host.example.invalid
PGDATABASE=database_name
PGUSER=application_user
PGPASSWORD=
PGPORT=5432
PGSSLMODE=require

DB_CONNECT_TIMEOUT_SECONDS=10
DB_APPLICATION_NAME=databricks-stock-research-capstone
